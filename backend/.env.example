# Copy this file to backend/.env and fill in the real values.
# backend/.env is the ONLY configuration file read by the application (ADR-0001 D4).
# Never commit backend/.env. Never put a credential default back into source.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=yfx_app
DB_PASSWORD=change_me_before_starting
DB_NAME=supplier_schedule_manager
# Optional: set DATABASE_URL to override the components above entirely.
# DATABASE_URL=mysql+pymysql://yfx_app:change_me@127.0.0.1:3306/supplier_schedule_manager?charset=utf8mb4

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Synthetic data ---
SYNTHETIC_DATA_SEED=20261022
DATASET_SCALE=full

# --- Business rule thresholds ---
AUTO_APPROVE_QTY_DELTA_MAX=0.0
PLANNER_APPROVE_QTY_DELTA_MAX=10.0
AUTO_APPROVE_PRICE_DELTA_MAX=0.0
PLANNER_APPROVE_PRICE_DELTA_MAX=5.0
AUTO_APPROVE_DELAY_DAYS_MAX=0
PLANNER_APPROVE_DELAY_DAYS_MAX=7
SUPPLIER_SILENCE_DAYS=5
